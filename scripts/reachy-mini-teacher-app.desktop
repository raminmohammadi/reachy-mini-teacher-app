[Desktop Entry]
Type=Application
Version=1.0
Name=Reachy Teacher
GenericName=Reachy Mini Teacher App
Comment=Start the Reachy Mini Teacher app and open its dashboard
# The Exec= line below is a template. scripts/install_launcher.sh rewrites
# it to the absolute path of launch_teacher_app.sh at install time.
Exec=INSTALL_DIR/scripts/launch_teacher_app.sh
Icon=reachy-mini-control
Terminal=false
Categories=Education;Science;
StartupNotify=true
StartupWMClass=reachy-mini-teacher-app
