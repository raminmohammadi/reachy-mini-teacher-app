[Desktop Entry]
Type=Application
Version=1.0
Name=Stop Reachy Teacher
GenericName=Stop the Reachy Mini Teacher App
Comment=Stop the running Reachy Mini Teacher app
# The Exec= line below is a template. scripts/install_launcher.sh rewrites
# it to the absolute path of stop_teacher_app.sh at install time.
Exec=INSTALL_DIR/scripts/stop_teacher_app.sh
Icon=process-stop
Terminal=false
Categories=Education;Science;
StartupNotify=false
